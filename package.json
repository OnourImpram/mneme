{
  "name": "mneme",
  "version": "4.1.0",
  "private": true,
  "description": "Vault-native memory for Claude Code. Markdown is ground truth.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnourImpram/mneme.git"
  },
  "bugs": {
    "url": "https://github.com/OnourImpram/mneme/issues"
  },
  "homepage": "https://github.com/OnourImpram/mneme#readme",
  "author": "Onour Impram",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter mneme-mcp-server test:coverage",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "bench": "make bench-all",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.0",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "hono": "4.13.1",
      "ip-address": "10.5.0"
    }
  },
  "keywords": [
    "claude-code",
    "memory",
    "mcp",
    "vault",
    "fts5",
    "rrf",
    "graphiti",
    "knowledge-graph",
    "markdown"
  ]
}
